rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isBootstrapAdmin() {
      return signedIn()
        && request.auth.token.email == 'dteixeira@viemar.com.br';
    }

    function ownProfile() {
      return get(/databases/$(database)/documents/toolflow_user_profiles/$(request.auth.uid));
    }

    function activeProfile() {
      return signedIn() && ownProfile().data.ativo == true;
    }

    function isStoredAdmin() {
      return activeProfile()
        && ownProfile().data.roleKey in ['ADMIN', 'ENG_PROCESSO', 'ENG_PRODUTO'];
    }

    function canOperate() {
      return activeProfile()
        && ownProfile().data.roleKey in [
          'ADMIN', 'ENG_PROCESSO', 'ENG_PRODUTO',
          'TECNICO_USINAGEM', 'TECNICO_MONTAGEM',
          'PRESET', 'GERENCIADOR', 'FORNECEDOR'
        ];
    }

    function isRequester() {
      return activeProfile()
        && ownProfile().data.roleKey == 'PRESET_SOLICITANTE';
    }

    function isRequesterOwner() {
      return isRequester()
        && resource.data.payload.solicitacao is map
        && request.resource.data.payload.solicitacao is map
        && resource.data.payload.solicitacao.solicitante is string
        && request.resource.data.payload.solicitacao.solicitante is string
        && resource.data.payload.solicitacao.solicitante.upper() == ownProfile().data.name.upper()
        && request.resource.data.payload.solicitacao.solicitante == resource.data.payload.solicitacao.solicitante
        && request.resource.data.payload.diff(resource.data.payload).affectedKeys().hasOnly([
          'solicitacao', 'timeline'
        ]);
    }
    function validProfile() {
      return request.resource.data.keys().hasOnly([
          'id', 'firebaseUid', 'name', 'email', 'roleKey', 'roleTitle',
          'role', 'avatarBg', 'ativo', 'updatedAtLocal', 'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.ativo is bool
        && request.resource.data.roleKey in [
          'ADMIN', 'ENG_PROCESSO', 'ENG_PRODUTO',
          'TECNICO_USINAGEM', 'TECNICO_MONTAGEM',
          'PRESET', 'PRESET_SOLICITANTE', 'GERENCIADOR', 'FORNECEDOR', 'VISITANTE'
        ];
    }

    function validTest() {
      return request.resource.data.keys().hasOnly([
          'id', 'ordem', 'payload', 'updatedBy', 'updatedAt'
        ])
        && request.resource.data.id is string
        && request.resource.data.ordem is int
        && request.resource.data.payload is map
        && request.resource.data.payload.id is string
        && request.resource.data.payload.id == request.resource.data.id
        && request.resource.data.updatedBy == request.auth.token.email
        && request.resource.data.updatedAt == request.time;
    }

    function validRequesterSubmission() {
      return validTest()
        && request.resource.data.payload.stage == 'STAGE_2_ANALISE'
        && request.resource.data.payload.statusGeral == 'AGUARDANDO_ANALISE'
        && request.resource.data.payload.solicitacao is map
        && request.resource.data.payload.analiseEngenharia is map
        && request.resource.data.payload.analiseEngenharia.size() == 0
        && request.resource.data.payload.agendamento is map
        && request.resource.data.payload.agendamento.size() == 0
        && request.resource.data.payload.chaoDeFabrica is map
        && request.resource.data.payload.chaoDeFabrica.keys().hasOnly([
          'parametros', 'registrosArestas'
        ])
        && request.resource.data.payload.chaoDeFabrica.parametros is map
        && request.resource.data.payload.chaoDeFabrica.parametros.size() == 0
        && request.resource.data.payload.chaoDeFabrica.registrosArestas is list
        && request.resource.data.payload.chaoDeFabrica.registrosArestas.size() == 0
        && request.resource.data.payload.fechamento is map
        && request.resource.data.payload.fechamento.size() == 0;
    }

    match /toolflow_user_profiles/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isStoredAdmin());
      allow create: if (isStoredAdmin() && validProfile())
        || (isBootstrapAdmin()
          && request.auth.uid == userId
          && request.resource.data.roleKey == 'ADMIN'
          && request.resource.data.email == request.auth.token.email
          && validProfile());
      allow update: if isStoredAdmin() && validProfile();
      allow delete: if isStoredAdmin() && userId != request.auth.uid;
    }

    match /toolflow_tests/{testId} {
      allow read: if activeProfile() || isBootstrapAdmin();
      allow create: if (canOperate() && validTest())
        || (isRequester() && validRequesterSubmission())
        || (isBootstrapAdmin() && validTest());
      allow update: if (
          (canOperate() || isBootstrapAdmin())
          && validTest()
          && request.resource.data.id == resource.data.id
        )
        || (isRequesterOwner() && validTest());
      allow delete: if isStoredAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
